# Copy to .env.local and set these values for your own application.
# Only public origins belong in VITE_*; all account/SMTP/database secrets live in server/.env.
VITE_ACCOUNT_API_URL=https://lab-api.heyflint.cn
VITE_APP_ORIGIN=https://lab.heyflint.cn
VITE_CONTENT_BASE_URL=https://lab-content.heyflint.cn

# For isolated local development, use matching 127.0.0.1 hosts:
# VITE_ACCOUNT_API_URL=http://127.0.0.1:3100
# VITE_CONTENT_BASE_URL=http://localhost:4176
