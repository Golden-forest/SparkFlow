# An ADDITIONAL site, imported from the existing /etc/caddy/Caddyfile.
# Replace api.example.com with an approved API DNS name pointing at this host.
# Never replace the existing CameraAI :8443 block or its TLS configuration.
api.example.com {
    encode zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin

    @api path /api/*
    handle @api {
        reverse_proxy 127.0.0.1:3100 {
            # Replace incoming values: the loopback backend trusts this proxy only.
            header_up X-Forwarded-For {remote_host}
            header_up X-Real-IP {remote_host}
        }
    }

    handle {
        respond "Not found" 404
    }
}
