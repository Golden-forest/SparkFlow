[Unit]
Description=Back up the SparkFlow account database
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
Environment=PGHOST=/var/run/postgresql
Environment=PGDATABASE=sparkflow_accounts
Environment=PGUSER=postgres
ExecStart=/usr/bin/bash /opt/sparkflow/accounts/ops/backup.sh /var/lib/sparkflow-backups
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sparkflow-backups
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
TimeoutStartSec=15min
StandardOutput=journal
StandardError=journal
