# Copy to /etc/sparkflow/accounts/runtime.env, owned root:sparkflow-accounts, mode 0640.
# This is a template. Never commit the completed file or put migration credentials here.
NODE_ENV=production
PORT=3100
AUTH_BASE_URL=https://api.example.com
APP_ORIGIN=https://app.example.com
AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DATABASE_URL=postgresql://sparkflow_app:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/sparkflow_accounts
DATABASE_APP_ROLE=sparkflow_app
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM="SparkFlow <accounts@example.com>"
