# Merge with the existing file. PostgreSQL uses the first matching rule.
# Preserve existing administrator access and inspect any broader earlier rules.
# The local OS postgres account is used for operator-only backup/restore.
local   all                 postgres                                peer
host    sparkflow_accounts   sparkflow_migrator   127.0.0.1/32        scram-sha-256
host    sparkflow_accounts   sparkflow_app        127.0.0.1/32        scram-sha-256
