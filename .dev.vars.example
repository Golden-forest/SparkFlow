# Copy to .dev.vars only when running Pages Functions locally.
# Protected deployments must set this in BOTH Production and Preview.
AUTH_GATE_ENABLED=true
# Generate the SHA-256 hash of your access code; do not store the code itself.
AUTH_CODE_HASH=
# Generate with: openssl rand -hex 32
AUTH_SECRET=
# Separate protected content deployment only; omit on the main application.
# AUTH_FRAME_ORIGIN=https://lab.heyflint.cn
