+def runtime_object(source: str) -> str | None:
+    """Inspect a literal assignment without truncating nested getter objects.
+
+    This is a static syntax aid; actual hook types/behavior still need browser checks.
+    """
+    match = re.search(r"window\.simulation\s*=\s*\{", source)
+    if not match:
+        return None
+    start = match.end() - 1
+    depth = 0
+    quote = None
+    escaped = False
+    comment = None
+    i = start
+    while i < len(source):
+        char = source[i]
+        following = source[i:i + 2]
+        if comment == "line":
+            if char == "\n": comment = None
+        elif comment == "block":
+            if following == "*/": comment = None; i += 1
+        elif quote:
+            if escaped: escaped = False
+            elif char == "\\": escaped = True
+            elif char == quote: quote = None
+        elif following == "//": comment = "line"; i += 1
+        elif following == "/*": comment = "block"; i += 1
+        elif char in "\"'`": quote = char
+        elif char == "{": depth += 1
+        elif char == "}":
+            depth -= 1
+            if depth == 0: return source[start + 1:i]
+        i += 1
+    return None
+
+
