{
  "name": "spark-flow-physics-lab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "manifest": "node --import tsx scripts/resource-manifest.ts",
    "predev": "node --import tsx scripts/resource-manifest.ts",
    "dev": "vite",
    "prebuild": "node --import tsx scripts/resource-manifest.ts",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p tsconfig.server.json && npm --prefix server run typecheck",
    "test": "npm run test:unit && npm run test:physics && npm run test:server && npm run test:accounts",
    "test:unit": "vitest run",
    "test:physics": "node --import tsx --test src/experiments/electromagnetism/*/__tests__/*.test.ts",
    "test:server": "node --import tsx --test tests/server/*.test.ts",
    "security": "npm audit --audit-level=high && npm --prefix server audit --audit-level=high",
    "verify": "npm run lint && npm run typecheck && npm test && npm run security && npm run build:accounts && npm run test:e2e && npm run test:e2e:accounts",
    "setup:accounts": "npm --prefix server ci",
    "dev:accounts": "npm --prefix server run dev",
    "build:accounts": "npm --prefix server run build",
    "build:content": "node --import tsx scripts/build-content.ts",
    "test:accounts": "npm --prefix server test",
    "test:e2e:accounts": "playwright test --config=playwright.account.config.ts",
    "preview": "vite preview",
    "import:courseware": "node --import tsx scripts/import-courseware.ts",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@react-spring/three": "^10.0.3",
    "@react-three/cannon": "^6.6.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "better-auth": "1.7.7",
    "cannon-es": "^0.20.0",
    "gsap": "^3.13.0",
    "i18next": "^23.16.8",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^15.7.4",
    "react-resizable-panels": "^4.4.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.6.0",
    "three": "^0.181.2",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "26.1.0",
    "tailwindcss": "^4.3.3",
    "tldts": "7.4.16",
    "tsx": "4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.3.6",
    "vitest": "4.1.11",
    "wrangler": "4.151.0"
  }
}
