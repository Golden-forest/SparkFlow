{
  "name": "spark-flow-account-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node --import tsx scripts/migrate.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build",
    "test:browser-fixture": "node --import tsx tests/browser-fixture.ts"
  },
  "dependencies": {
    "better-auth": "1.7.7",
    "kysely": "0.29.6",
    "nodemailer": "10.0.15",
    "pg": "8.23.1",
    "tldts": "7.4.16"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
