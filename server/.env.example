NODE_ENV=development
APP_NAME=Spark Flow
PORT=3100
AUTH_BASE_URL=http://127.0.0.1:3100
APP_ORIGIN=http://127.0.0.1:5173
# Generate locally: openssl rand -hex 32
AUTH_SECRET=
DATABASE_URL=postgresql://sparkflow_app:replace-me@127.0.0.1:5432/sparkflow_accounts
# Migration credentials belong in a separate .env.migration, never runtime env.
DATABASE_APP_ROLE=sparkflow_app
DATABASE_POOL_MAX=10
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=Spark Flow <accounts@example.test>
# Production requires SMTP authentication and TLS (465 implicit or 587 STARTTLS).
SMTP_USER=
SMTP_PASSWORD=
