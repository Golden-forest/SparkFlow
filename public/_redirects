# Cloudflare Pages routing rules
# https://developers.cloudflare.com/pages/configuration/redirects/

# Serve courseware subdirectory index.html for directory-style URLs
# e.g. /courseware/foo/ -> /courseware/foo/index.html
/courseware/*  /courseware/:splat/index.html  200

# SPA fallback: all unmatched routes return index.html with 200 status
/*             /index.html                    200
